{
  "name": "diff-sensei-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Autonomous AI Code Review Agent (React 19 + Tailwind v4 + Fastify + TypeScript)",
  "author": "Prabhat Ranjan Singh <topi9864@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev:backend": "pnpm --filter ./backend dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev": "pnpm --filter ./backend dev",
    "build:backend": "pnpm --filter ./backend build",
    "build:frontend": "pnpm --filter ./frontend build",
    "build": "pnpm build:frontend && pnpm build:backend",
    "start": "pnpm --filter ./backend start",
    "review": "pnpm --filter ./backend review"
  }
}
